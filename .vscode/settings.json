{
  "files.exclude": {
    "**/DerivedData/**": true,
    "**/.build/**": true
  },
  "search.exclude": {
    "**/DerivedData/**": true,
    "**/.build/**": true,
    "**/*.xcodeproj/**": true
  },
  "editor.rulers": [100],
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "debug.internalConsoleOptions": "openOnSessionStart",
  "debug.console.closeOnEnd": false,
  "sweetpad.xcodegen.autogenerate": true,
  "sweetpad.build.xcodeWorkspacePath": "SiteLog.xcodeproj",
  "sweetpad.build.scheme": "SiteLog"
}
