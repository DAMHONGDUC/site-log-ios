{
  "files.exclude": {
    "**/DerivedData/**": true,
    "**/.build/**": true
  },
  "search.exclude": {
    "**/DerivedData/**": true,
    "**/.build/**": true,
    "**/*.xcodeproj/**": true
  },
  "editor.rulers": [100],
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "debug.internalConsoleOptions": "openOnSessionStart",
  "debug.console.closeOnEnd": false,
  // CodeLLDB: Debug Console evaluates expressions directly (no '?' prefix, no mode banner).
  // LLDB commands still work with a '/cmd ' prefix, e.g. `/cmd bt`.
  "lldb.consoleMode": "evaluate",
  // Sources are synced folders: adding a file never needs xcodegen.
  "sweetpad.xcodegen.autogenerate": false,
  "sweetpad.build.xcodeWorkspacePath": "SiteLog.xcodeproj",
  "sweetpad.build.scheme": "SiteLog",
  // Guide preview: same 16 px indent for sub-sections as GitHub.
  "markdown.styles": [".vscode/markdown-preview.css"]
}
